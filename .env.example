# ULTRON workspace
ULTRON_WORKSPACE=.

# Safe defaults
ULTRON_DRY_RUN=true
ULTRON_AUTOMATION_ENABLED=false
ULTRON_AUTO_PROMPT_ENABLED=false

# Runtime cadence
ULTRON_POLL_INTERVAL_SECONDS=10
ULTRON_MAX_ITERATIONS=1

# Local API
ULTRON_API_HOST=127.0.0.1
ULTRON_API_PORT=8765
# ULTRON_API_TOKEN=change-me

# Recommended free-tier/cloud providers
# Gemini: create a key in Google AI Studio.
# Keep this on the Free tier unless you intentionally enable billing.
# GEMINI_API_KEY=

# OpenRouter: use the free router (openrouter/free) by default.
# The OpenRouter free plan currently has usage limits.
# OPENROUTER_API_KEY=

# Completely local option: install Ollama and pull a model locally.
# No cloud API key or provider billing is required.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=

# Paid/optional providers are still supported by the existing desktop/API adapters,
# but they are not required for the free-first setup.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# CURSOR_API_KEY=

# OCR when Tesseract is not on PATH
# ULTRON_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
