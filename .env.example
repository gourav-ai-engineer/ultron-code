# ULTRON workspace
ULTRON_WORKSPACE=.

# Safe defaults
ULTRON_DRY_RUN=true
ULTRON_AUTOMATION_ENABLED=false
ULTRON_AUTO_PROMPT_ENABLED=false

# Runtime cadence
ULTRON_POLL_INTERVAL_SECONDS=10
ULTRON_MAX_ITERATIONS=1

# Local API
ULTRON_API_HOST=127.0.0.1
ULTRON_API_PORT=8765
# ULTRON_API_TOKEN=change-me

# Provider API credentials
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# CURSOR_API_KEY=

# OCR when Tesseract is not on PATH
# ULTRON_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
